# PostgreSQL (docker-compose.db.yml)
POSTGRES_USER=mes
POSTGRES_PASSWORD=mes_secret_change_me
POSTGRES_DB=mes_imla
POSTGRES_PORT=5432

# App (docker-compose.app.yml)
# Use service hostname "postgres" when both compose share network mes-imla-net
PORT=3100
DATABASE_URL=postgres://mes:mes_secret_change_me@postgres:5432/mes_imla

TZ=America/Los_Angeles

# Node-RED response (set RESPONSE_ENABLED=false to return 204 No Content)
RESPONSE_ENABLED=true
RESPONSE_BODY={"ok":true,"received":{{received}}}

# Optional EOL camera labels (overrides defaults). Format: id:Label,id:Label
# EOL_CAMERA_MAP=ov80i-gsac586514:EOL1,ov80i-gsac586492:EOL2,192.168.11.176:EOL3
