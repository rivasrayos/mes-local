  {
    "id": "imla_test_setup_globals",
    "type": "function",
    "z": "imla_test_inject_tab",
    "name": "setup test globals (SN/recipe/env)",
    "func": "// Globals que usa pack_mes_v2_msg\nglobal.set('capture_metadata', {\n  slot1: 'SN-TEST-0001',\n  slot2: 'SN-TEST-0002',\n  slot3: 'SN-TEST-0003',\n  slot4: 'SN-TEST-0004',\n  slot5: 'SN-TEST-0005',\n  slot6: 'SN-TEST-0006',\n  slot7: 'SN-TEST-0007',\n  slot8: 'SN-TEST-0008'\n});\nglobal.set('recipe_version', 'recipe-test-1.0');\n\n// Si tus env vars de Node-RED no están definidas, pack usará defaults.\n// En el nodo pack ya tienes MES_BASE_URL apuntando a /api/inspections.\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 520,
    "y": 160,
    "wires": [
